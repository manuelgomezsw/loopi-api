            "url": {
              "raw": "{{base_url}}/api/inventories/latest",
              "host": ["{{base_url}}"],
              "path": ["api", "inventories", "latest"]
            }
          }
        },
        {
          "name": "Create Daily Inventory (Opening)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('inventory_id', jsonData.id);",
                  "    console.log('Inventory ID saved:', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"inventory_type\": \"daily\",\n    \"schedule\": \"opening\",\n    \"date\": \"2026-02-05\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/inventories",
              "host": ["{{base_url}}"],
              "path": ["api", "inventories"]
            }
          }
        },
