# loopi-api — Configuración local
# Copiar este archivo como .env y completar los valores.
# NUNCA commitear .env con valores reales.

# Servidor
SERVER_PORT=8080
APP_ENV=development

# Base de datos (local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=loopi

# =============================================================================
# SECRETOS — Gestionados por GCP Secret Manager en producción.
# Para desarrollo local: solicitar los valores al equipo y colocarlos aquí.
# En producción App Engine los inyecta automáticamente desde Secret Manager.
# =============================================================================

# Contraseña MySQL del usuario loopi
# Producción: Secret Manager → loopi-db-password (proyecto quotes-api-100)
DB_PASSWORD=

# Clave para firmar tokens JWT
# Producción: Secret Manager → loopi-jwt-secret (proyecto quotes-api-100)
JWT_SECRET=

# JWT
JWT_EXPIRATION_HOURS=24

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# Observabilidad
SERVICE_NAME=loopi-api
SERVICE_VERSION=dev
SERVICE_ENV=development

# Zona horaria
TZ=America/Bogota
